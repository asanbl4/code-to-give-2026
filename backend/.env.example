# Origins allowed to call this API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Supabase. Leave these blank and the API still boots -- /health and /api/hello
# work, and only the database-backed routes return 503. Fill them in when you
# need /api/participants.
#
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in a browser; RLS is what protects
# the data behind it.
SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. Bypasses RLS entirely. Server-side only -- never
# put this behind a NEXT_PUBLIC_ variable. Only needed for staff tooling that
# writes participant records.
SUPABASE_SECRET_KEY=

# --- Instagram feature -------------------------------------------------------
# Leave INSTAGRAM_ACCESS_TOKEN empty to serve bundled sample posts (no Instagram
# calls). Set it to a long-lived Instagram Graph API token to serve real posts.
# See docs/instagram-setup.md for how to obtain the token.
INSTAGRAM_ACCESS_TOKEN=
# "me" resolves to the token's own account; or set a specific IG user id.
INSTAGRAM_USER_ID=me
# Seconds a live fetch is cached before Instagram is hit again.
INSTAGRAM_CACHE_TTL_SECONDS=300

# --- Chatbot feature ---------------------------------------------------------
# false hides the launcher and makes /api/chat return 503, so a teammate who
# has not installed Ollama still gets a working site.
CHATBOT_ENABLED=true
# Use 127.0.0.1, not localhost: localhost may resolve to ::1, which Ollama does
# not listen on by default, and the chatbot then degrades on every request.
# (frontend/.env.local.example carries the same warning for NEXT_PUBLIC_API_URL.)
OLLAMA_HOST=http://127.0.0.1:11434
# qwen3:4b is better but needs a GPU that can hold it alongside bge-m3 at the
# same time; on 4GB they evict each other and every answer degrades. `ollama ps`
# must list both models at once.
CHATBOT_MODEL=qwen3:1.7b
CHATBOT_EMBED_MODEL=bge-m3
# The only threshold left. How close a question must be to a refusal entry to
# be treated as medical or self-harm and answered by staff words, not the model.
# Sits between 0.728 ("I feel like ending it", must refuse) and 0.427 ("what is
# the weather in Tokyo", must not). See app/config.py.
CHATBOT_REFUSAL_CONFIDENCE=0.55
CHATBOT_TIMEOUT_SECONDS=20
# How long Ollama holds a model in memory. Its 5m default is shorter than the
# gaps between demo questions, and a reload costs ~7s -- enough to push an
# answer past CHATBOT_TIMEOUT_SECONDS and degrade it to the curated fallback.
CHATBOT_KEEP_ALIVE=30m
