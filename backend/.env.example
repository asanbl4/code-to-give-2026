# Project Settings -> Data API -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> publishable key (sb_publishable_...)
SUPABASE_PUBLISHABLE_KEY=

# Project Settings -> API Keys -> secret key (sb_secret_...)
# Bypasses row-level security. Server-side only. Optional unless you use get_admin_db().
SUPABASE_SECRET_KEY=

# Only for legacy projects that still sign JWTs with HS256.
# Leave empty for projects using asymmetric signing keys (the current default).
SUPABASE_JWT_SECRET=

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
