# Where the FastAPI backend is listening.
# Prefer 127.0.0.1 over localhost: Node may resolve localhost to ::1, which
# uvicorn is not bound to by default.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Supabase, for staff sign-in. Both are public by design: the publishable key is
# meant to ship in a browser bundle, and RLS is what protects the data behind
# it. Never put the secret / service-role key behind a NEXT_PUBLIC_ variable --
# it bypasses RLS entirely and these values are inlined into the bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
