# Project Settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API Keys -> publishable key (sb_publishable_...)
# Safe to expose to the browser; RLS is what protects your data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the FastAPI backend is listening.
# Prefer 127.0.0.1 over localhost: Node may resolve localhost to ::1, which
# uvicorn is not bound to by default.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
