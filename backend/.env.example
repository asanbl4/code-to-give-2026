# Origins allowed to call this API from a browser (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Supabase. Leave these blank and the API still boots -- /health and /api/hello
# work, and only the database-backed routes return 503. Fill them in when you
# need /api/participants.
#
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...). Safe in a browser; RLS is what protects
# the data behind it.
SUPABASE_PUBLISHABLE_KEY=
# Secret / service-role key. Bypasses RLS entirely. Server-side only -- never
# put this behind a NEXT_PUBLIC_ variable. Only needed for staff tooling that
# writes participant records.
SUPABASE_SECRET_KEY=

# --- Instagram feature -------------------------------------------------------
# Leave INSTAGRAM_ACCESS_TOKEN empty to serve bundled sample posts (no Instagram
# calls). Set it to a long-lived Instagram Graph API token to serve real posts.
# See docs/instagram-setup.md for how to obtain the token.
INSTAGRAM_ACCESS_TOKEN=
# "me" resolves to the token's own account; or set a specific IG user id.
INSTAGRAM_USER_ID=me
# Seconds a live fetch is cached before Instagram is hit again.
INSTAGRAM_CACHE_TTL_SECONDS=300

# --- Chatbot feature ---------------------------------------------------------
# false hides the launcher and makes /api/chat return 503, so a teammate who
# has not installed Ollama still gets a working site.
CHATBOT_ENABLED=true
# Use 127.0.0.1, not localhost -- see the note on NEXT_PUBLIC_API_URL.
OLLAMA_HOST=http://127.0.0.1:11434
CHATBOT_MODEL=qwen3:4b
CHATBOT_EMBED_MODEL=bge-m3
CHATBOT_HIGH_CONFIDENCE=0.75
CHATBOT_LOW_CONFIDENCE=0.55
CHATBOT_TIMEOUT_SECONDS=20
